# General
HOST=localhost
PORT=8080
WORKERS=1

# Seamless File Server
# the address under which the other servers and the relay reach this server (the same as in SERVERS of the relay)
ORIGIN=http://localhost:8080
RELAY_URL=http://localhost:8787
# the public key of the relay: `sfs keygen`
RELAY_PUBLIC_KEY=
# the token of this server alone: `sfs token` (put its SHA-256 in SERVERS of the relay)
TOKEN=
